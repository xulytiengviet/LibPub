{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xulytiengviet.github.io/LibPub/schemas/metadata.schema.json",
  "title": "LibPub article metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "slug",
    "title",
    "abstract",
    "keywords",
    "language",
    "articleType",
    "status",
    "version",
    "publishedDate",
    "license",
    "authors"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100
    },
    "title": { "type": "string", "minLength": 10, "maxLength": 500 },
    "subtitle": { "type": "string", "maxLength": 500 },
    "abstract": { "type": "string", "minLength": 20, "maxLength": 10000 },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 100 }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$" },
    "articleType": {
      "enum": ["research-article", "review-article", "case-report", "methods-article", "data-paper", "policy-paper", "other"]
    },
    "status": { "enum": ["preprint", "published", "revised", "withdrawn"] },
    "version": { "type": "integer", "minimum": 1 },
    "doi": {
      "type": "string",
      "pattern": "^$|^10\\.\\d{4,9}/[-._;()/:A-Za-z0-9]+$"
    },
    "publishedDate": { "type": "string", "format": "date" },
    "receivedDate": { "type": "string", "format": "date" },
    "acceptedDate": { "type": "string", "format": "date" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "properties": {
        "id": { "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "ARR"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["given", "family", "affiliations"],
        "properties": {
          "given": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1 },
          "orcid": { "type": "string", "pattern": "^$|^https://orcid\\.org/\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" },
          "email": { "type": "string" },
          "corresponding": { "type": "boolean" },
          "affiliations": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "affiliations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "city": { "type": "string" },
          "country": { "type": "string" }
        }
      }
    },
    "funding": { "type": "string", "maxLength": 5000 },
    "conflictOfInterest": { "type": "string", "maxLength": 5000 },
    "dataAvailability": { "type": "string", "maxLength": 5000 }
  }
}

